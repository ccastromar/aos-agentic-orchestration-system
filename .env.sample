APP_ENV=local
PORT=8080
AOS_API_KEY=DONOTUSEINPRODUCTION
AOS_JWT_ISSUER=http://issuer:9080/realms/aos
AOS_JWT_AUDIENCE=aos-core
AOS_JWK_URL=http://issuer:9080/realms/aos/protocol/openid-connect/certs

# If NO IAM:
AOS_IAM_URL=disabled

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_INTENT_MODEL=qwen3:1.7b
OLLAMA_NUM_CTX=8192
OLLAMA_REACT_NUM_PREDICT=4096
GEMINI_API_KEY=YOURAPIKEY
LOG_COLOR=1
LLM_ENGINE=ollama
LLM_MODEL=qwen3:4b
#LLM_ENGINE=gemini
#LLM_MODEL=gemini-2.5-flash-lite

REDIS_ADDR=redis:6379
REDIS_PASSWORD=YOURPASSWORD
# Choose memory, sqlite, postgres, or redis. Empty keeps legacy auto-selection.
# Production: postgres. Local development: sqlite.
AOS_STATE_STORE=
AOS_SQLITE_PATH=./data/aos-state.db
#AOS_POSTGRES_URL=postgres://aos:secret@db:5432/aos?sslmode=require
AUDIT_LOG_PATH=./data/aos-audit.jsonl

# Optional Ernest audit export (POST <URL>/events). Set the same value as
# EVENT_INGESTOR_API_KEY in Ernest. In local development the key may be empty.
ERNEST_INGESTOR_URL=
ERNEST_INGESTOR_API_KEY=
# Set this to EVENT_PROVIDER_HMAC_SECRET if Ernest requires provider HMAC.
ERNEST_INGESTOR_HMAC_SECRET=
# Key the audit hashes are digested with before they leave AOS (contract/audit-events): at least
# 32 bytes, from a key vault or secret store; or AOS_EVIDENCE_KEY_FILE pointing at a mounted
# file. Required outside development when evidence goes to Ernest. Keep it: never change it.
AOS_EVIDENCE_KEY=
ERNEST_INGESTOR_TIMEOUT=5s
